# SyncWatch Server Configuration
# Copy this file to .env and fill in your tokens
# NEVER commit .env with real tokens!

# Server port (default: 8765)
SYNCWATCH_PORT=8765

# GitHub personal access token (for server discovery registration)
# Create at: https://github.com/settings/tokens (needs repo scope)
SYNCWATCH_GITHUB_TOKEN=ghp_your_token_here

# ngrok auth token (for public tunneling - get free at https://dashboard.ngrok.com)
SYNCWATCH_NGROK_TOKEN=your_ngrok_token_here
